# Never commit your real .env file. Railway variables are entered in its dashboard.
# DATABASE_URL: use Add Reference to your PostgreSQL service on ALL three services.
# Local development only:
DATABASE_URL=sqlite:///leads.db
BOT_TOKEN=
SECRET_KEY=
ADMIN_PASSWORD_HASH=
ADMIN_TELEGRAM_IDS=
COOKIE_SECURE=1
BRAND_NAME=راجح | رؤية الأسواق
MONITOR_CLOSE_DELAY_SECONDS=45
MONITOR_CONCURRENCY=12
# Optional research notifications; numeric administrator IDs only. Empty = store events only.
MONITOR_ADMIN_ALERT_IDS=
# Optional JSON policy file, absolute or relative to /app:
MONITOR_POLICY_FILE=

# Enabled on both bot and scanner services; 0 pauses new customer alerts.
US_RECOMMENDATIONS_ENABLED=1
